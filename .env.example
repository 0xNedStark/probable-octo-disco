DATABASE_URL=postgres://solar:solar@localhost:5432/solar
TEST_DATABASE_URL=postgres://solar:solar@localhost:5432/solar_test
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage
S3_BUCKET=
S3_REGION=ap-south-1
# Seeded admin user (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# Base URL customers open proposal links on
PUBLIC_BASE_URL=http://localhost:3000
# Bill Agent (Claude vision). Off by default; needs Anthropic credentials (ANTHROPIC_API_KEY) when on.
AI_BILL_EXTRACTION=off
AI_BILL_MODEL=claude-opus-5-5
AI_BILL_EFFORT=medium
AI_BILL_CONFIDENCE_THRESHOLD=0.9
