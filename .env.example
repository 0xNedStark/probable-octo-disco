DATABASE_URL=postgres://solar:solar@localhost:5432/solar
TEST_DATABASE_URL=postgres://solar:solar@localhost:5432/solar_test
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage
S3_BUCKET=
S3_REGION=ap-south-1
# Seeded admin user (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# Base URL customers open proposal links on
PUBLIC_BASE_URL=http://localhost:3000
# Bill Agent (Claude vision). Off by default; needs Anthropic credentials (ANTHROPIC_API_KEY) when on.
AI_BILL_EXTRACTION=off
AI_BILL_MODEL=claude-opus-5-5
AI_BILL_EFFORT=medium
AI_BILL_CONFIDENCE_THRESHOLD=0.9
# Signs customer status-page links (/s/...). Any long random string; rotating it revokes old links.
STATUS_LINK_SECRET=change-me-status-secret
# Payments: razorpay | dev (local test gateway) | unset (manual recording only)
PAYMENTS_PROVIDER=dev
PAYMENTS_WEBHOOK_SECRET=change-me-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# WhatsApp: meta to send for real; anything else logs messages instead
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Sales Agent (Claude) for WhatsApp replies; off sends every message to the human inbox
AI_SALES_AGENT=off
AI_SALES_EFFORT=low
