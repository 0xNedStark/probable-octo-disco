{
  "name": "solar-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @solar/web dev",
    "worker": "pnpm --filter @solar/worker start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm --filter @solar/web build",
    "db:generate": "pnpm --filter @solar/db generate",
    "db:migrate": "pnpm --filter @solar/db migrate",
    "db:seed": "pnpm --filter @solar/db seed",
    "e2e": "pnpm --filter @solar/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
